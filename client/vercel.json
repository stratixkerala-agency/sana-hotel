{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://finitix-solution-api.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://finitix-solution-api.onrender.com/uploads/$1" },
    { "source": "/((?!api/|uploads/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
